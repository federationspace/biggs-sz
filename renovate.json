{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeBranch"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "suppressNotifications": ["prEditedNotification", "prIgnoreNotification"],
  "rebaseWhen": "conflicted",
  "schedule": ["before 6am"],
  "flux": {
    "managerFilePatterns": ["/(^|/)clusters/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/(^|/)clusters/.+/helmrelease\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)clusters/.+\\.ya?ml$/",
      "/(^|/)clusters/.+/(deployment|job|cronjob|daemonset|statefulset)\\.ya?ml$/",
      "/(^|/)clusters/.+-deployment\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Process OCIRepository tags",
      "managerFilePatterns": ["/(^|/)clusters/.+-oci\\.ya?ml$/"],
      "matchStrings": [
        "url:\\s*oci://(?<depName>[^\\s]+)\\s*\\n\\s*ref:\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Ceph image: only stable x.2.z tags if ever pinned; normally unpinned and set by the Rook chart default",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/ceph/ceph"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<build>\\d{8}))?$",
      "allowedVersions": "/^v\\d+\\.2\\.\\d+(-\\d{8})?$/",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Linuxserver images tag as X.Y.Z.BUILD-lsNNN (e.g. 4.0.20.3014-ls325). The default docker versioning treats the -lsNNN suffix as a compatibility marker, so a newer base-image build of the same app version is never proposed; explicit groups make lsNNN the last compared component, which reads as a patch bump and lands in the media-apps group. Anchored so arch-prefixed (amd64-*) and floating (develop-*, version-*) tags are excluded. Matches both registries so a future lscr.io pin is covered too",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^(lscr\\.io|ghcr\\.io)/linuxserver//"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-ls(?<revision>\\d+)$"
    },
    {
      "description": "Plex tags as X.Y.Z.BUILD-<git hash> (e.g. 1.43.4.10903-e5521bd8c). Default docker versioning treats the hash as a compatibility suffix that changes every release, so no newer tag would ever be proposed; this regex compares the four numeric parts and ignores the hash. Anchored so the -amd64/-arm64/-armhf arch aliases and the beta/latest tags are excluded",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$"
    },
    {
      "description": "Flux HelmRelease dependencies",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "commitMessageTopic": "chart {{depName}}"
    },
    {
      "description": "Auto-merge non-major Helm chart updates",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Rook charts pick the default Ceph version (a minor Rook bump can carry a Ceph major); never automerge, merge by hand after reading the release notes and checking ceph health detail",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["/^rook-ceph/"],
      "automerge": false
    },
    {
      "description": "Group Rook Ceph charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "rook-ceph",
      "matchPackageNames": ["/^rook-ceph/"]
    },
    {
      "description": "Group VictoriaMetrics charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "victoria-metrics",
      "matchPackageNames": ["/^victoria/"]
    },
    {
      "description": "Group external-secrets charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "external-secrets",
      "matchPackageNames": ["/external-secrets/", "/connect/"]
    },
    {
      "description": "Group observability charts",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "groupName": "observability",
      "matchPackageNames": ["/grafana/", "/prometheus/"]
    },
    {
      "description": "Semantic versioning for Cilium",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "matchPackageNames": ["cilium"],
      "separateMajorMinor": true
    },
    {
      "description": "Semantic versioning for cert-manager",
      "matchManagers": ["flux"],
      "matchDatasources": ["helm"],
      "matchPackageNames": ["cert-manager"],
      "separateMajorMinor": true
    },
    {
      "description": "Group media app container images",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["clusters/**/media/**"],
      "groupName": "media-apps"
    },
    {
      "description": "Auto-merge patch updates for media apps",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["docker"],
      "matchFileNames": ["clusters/**/media/**"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Jellyfin upgrades break the Ombi integration (Ombi-app/Ombi#5478); guard against the media-apps patch automerge above so every jellyfin bump stays a reviewed, opt-in PR",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["jellyfin/jellyfin"],
      "automerge": false
    },
    {
      "description": "Plex releases land as patch bumps under the regex above, which the media-apps patch automerge would push straight to main; keep every plex bump a reviewed PR",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "automerge": false
    }
  ]
}
